{
  "name": "@trama-dev/cli",
  "version": "0.9.0",
  "type": "module",
  "bin": {
    "trama": "dist/index.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && chmod +x dist/index.js",
    "prepack": "rm -rf examples && cp -R ../../examples examples",
    "postpack": "rm -rf examples"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "The command line of trama — a runtime in which an agent's behaviour lives as programs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NaNhkNaN/trama.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/NaNhkNaN/trama",
  "bugs": "https://github.com/NaNhkNaN/trama/issues",
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "os": ["darwin", "linux"],
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@trama-dev/runtime": "0.9.0",
    "commander": "15.1.0"
  }
}
